{
  "type": "controller",
  "name": "EmailAccessMapping",
  "module": "shared",
  "description": "Super-admin management of email access mappings (SPEC_EMAIL_ACCESS_MAPPING.md). JWT super-admin only; the gate is in SecurityConfig, not here.",
  "basePath": "email-access-mappings",
  "id": "eamctrl001-CONTROLLER",
  "actions": [
    {
      "actionName": "createMapping",
      "method": "POST",
      "requestBody": {
        "content": {
          "application/json": {
            "schema": {
              "type": "EmailAccessMappingRequest",
              "objectType": "dto",
              "name": "data",
              "collectionType": "none",
              "module": "shared"
            }
          }
        }
      },
      "responses": {
        "201": {
          "name": "Created",
          "content": {
            "application/json": {
              "schema": {
                "type": "EmailAccessMapping",
                "objectType": "dto",
                "name": "data",
                "collectionType": "none",
                "module": "shared"
              }
            }
          },
          "description": "The mapping, active"
        }
      }
    },
    {
      "actionName": "listMappings",
      "method": "GET",
      "responses": {
        "200": {
          "name": "OK",
          "content": {
            "application/json": {
              "schema": {
                "type": "WrapperListaEmailAccessMapping",
                "objectType": "dto",
                "name": "data",
                "collectionType": "none",
                "module": "shared"
              }
            }
          },
          "description": "Page of mappings, revoked included; filters email (contains) and status (active|revoked|expired)"
        }
      },
      "queryParams": [
        {
          "name": "pageNumber",
          "type": "integer",
          "isRequired": false,
          "description": "Page number, 0-based"
        },
        {
          "name": "pageSize",
          "type": "integer",
          "isRequired": false,
          "description": "Page size, default 20, max 100"
        },
        {
          "name": "email",
          "type": "string",
          "isRequired": false,
          "description": "Contains, case-insensitive"
        },
        {
          "name": "status",
          "type": "string",
          "isRequired": false,
          "description": "active | revoked | expired"
        }
      ]
    },
    {
      "actionName": "updateMapping",
      "path": "{id}",
      "method": "PUT",
      "requestBody": {
        "content": {
          "application/json": {
            "schema": {
              "type": "EmailAccessMappingRequest",
              "objectType": "dto",
              "name": "data",
              "collectionType": "none",
              "module": "shared"
            }
          }
        }
      },
      "responses": {
        "200": {
          "name": "OK",
          "content": {
            "application/json": {
              "schema": {
                "type": "EmailAccessMapping",
                "objectType": "dto",
                "name": "data",
                "collectionType": "none",
                "module": "shared"
              }
            }
          },
          "description": "Permissions, description, expiry replaced"
        }
      },
      "pathVariables": [
        {
          "name": "id",
          "type": "string",
          "isRequired": true,
          "description": "Mapping id"
        }
      ]
    },
    {
      "actionName": "revokeMapping",
      "path": "{id}",
      "method": "DELETE",
      "responses": {
        "204": {
          "name": "OK",
          "content": {
            "application/json": {
              "schema": {
                "type": "string",
                "name": "data",
                "collectionType": "none"
              }
            }
          }
        }
      },
      "pathVariables": [
        {
          "name": "id",
          "type": "string",
          "isRequired": true,
          "description": "Mapping id"
        }
      ]
    }
  ]
}
