SERVICE_PROFILE=development
SERVICE_PORT=8082
SERVICE_NAME=igrpplatformprocessmanagerstudio-service

KUBERNETES_DISCOVERY_ENABLED=false
EUREKA_CLIENT_SERVICEURL_DEFAULTZONE=http://igrp-eureka:8761/eureka/
EUREKA_CLIENT_ENABLED=true


LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_SPRING_WEB=DEBUG
LOGGING_LEVEL_APP=DEBUG

POSTGRES_SERVICE_NAME=postgres
# Use <localhost> to conect to a database in docker with api outside, use <host.docker.internal> when running the full app, database inside docker desktop locally
POSTGRES_HOST=host.docker.internal
POSTGRES_PORT=5432
POSTGRES_DATABASE=igrpplatformprocessmanagerstudio_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

AUTH_JWT_ISSUER=https://demoigrp.nosi.cv/auth/realms/igrp

ENABLE_SWAGGER=true

IGRP_PROCESS_ENGINE_BASE_URL=http://localhost:8080

# Authorization adapter. Possible values: default|irn
IGRP_AUTHORIZATION_SERVICE_ADAPTER=irn

# Comma-separated browser origins allowed for CORS (with credentials). Empty = no cross-origin
# access at all — the previous wildcard+credentials setup let any site ride the user's session.
IGRP_CORS_ALLOWED_ORIGINS=http://localhost:3000

# JWT claim used as the principal name — the identity recorded on tasks, audit columns and logs.
# MUST match the identity format task assignments use. IRN assigns by email, so 'email' is required
# for "my tasks" visibility matching; decide before go-live, never switch with existing data.
IGRP_SECURITY_PRINCIPAL_CLAIM_NAME=email

# IRN identity provider, required when the adapter above is 'irn'
IRN_API_BASE_URL=https://dsv-api-backoffice.irn.lan/exp-cvt-system-administration
IRN_API_SUPER_ADMIN_EMAIL=CHANGE_ME@irn.mj.pt
IRN_API_SESSION_COOKIE_NAME=session_id

# Signed RS256 client used to call the IRN API
IGRP_RESTCLIENT_PROVIDER=irn
IGRP_AUTHORIZATION_JWT_KEY=CHANGE_ME_JWT_KEY
IGRP_AUTHORIZATION_JWT_PRIVATE_KEY=file:/etc/igrp/keys/irn-private-key.pem

# Set to false to fall back to authenticated-only on routes with no rule (not recommended)
IRN_AUTHORIZATION_DENY_UNMATCHED=true

# Observability
# If you need observability, just enable the OpenTelemetry
OTEL_DISABLED=false
OTEL_COLLECTOR_ENDPOINT=http://localhost:4318



